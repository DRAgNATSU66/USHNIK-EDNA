# Copy this to .env and fill in values. Never commit .env.

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=synthveda

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Deployment environment: dev | test | staging | production (default dev).
# Outside dev/test the API refuses to start unless JWT_SECRET is a real secret
# of at least 32 bytes (B18, services/api/app/config.py).
APP_ENV=dev

# JWT -- generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS (JSON array — pydantic-settings JSON-decodes this list-typed field
# before any comma-split fallback runs, so it must be valid JSON)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Possible-novelty cutoff (B14). Read by BOTH api and worker (compose gives
# them this same file); /health reports it to the frontend. Default 0.45.
# NOVELTY_THRESHOLD=0.45

# Route classifier (B19). Unset: the worker uses the learned k-mer router from
# the registry entry with route "router" and falls back to the heuristic,
# visibly (router_method=heuristic_fallback), if it cannot load. Set to
# "heuristic" to force the heuristic router (kill switch).
# SYNTHVEDA_ROUTER=heuristic

# Upload storage (B7, services/*/app/storage.py). Read by BOTH api (writes)
# and worker (reads). local = files under UPLOAD_STORAGE_DIR (the default;
# use an absolute path when api and worker run from different directories).
# s3 = an S3-compatible bucket. docker-compose overrides these to use its
# MinIO service; for a host-run api/worker against that MinIO use
# OBJECT_STORAGE_URL=http://localhost:9000 and the MINIO_ROOT_* values.
STORAGE_BACKEND=local
# UPLOAD_STORAGE_DIR=/absolute/path/to/uploads
OBJECT_STORAGE_URL=
OBJECT_STORAGE_BUCKET=synthveda-uploads
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1

# Environmental context per upload (Q5, services/api/app/environment/). Public
# temperature/salinity/DO/pH/currents (Copernicus Marine, NOAA ERDDAP) and wind
# (ERA5 via Open-Meteo: free tier is NON-COMMERCIAL only) for uploads with
# coordinates + collected_at. A free Copernicus Marine account is optional but
# recommended: without it the ARCO stores are read anonymously (undocumented).
# ENVIRONMENT_CONTEXT_ENABLED=true
# ENVIRONMENT_PROVIDER_TIMEOUT_S=15
# ENVIRONMENT_PROVIDER_RETRIES=1
# ENVIRONMENT_MAX_CELL_DISTANCE_KM=30
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
