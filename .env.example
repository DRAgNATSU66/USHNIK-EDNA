# Copy this to .env and fill in values. Never commit .env.

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=synthveda

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS (JSON array — pydantic-settings JSON-decodes this list-typed field
# before any comma-split fallback runs, so it must be valid JSON)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Possible-novelty cutoff (B14). Read by BOTH api and worker (compose gives
# them this same file); /health reports it to the frontend. Default 0.45.
# NOVELTY_THRESHOLD=0.45

# Upload storage (B7, services/*/app/storage.py). Read by BOTH api (writes)
# and worker (reads). local = files under UPLOAD_STORAGE_DIR (the default;
# use an absolute path when api and worker run from different directories).
# s3 = an S3-compatible bucket. docker-compose overrides these to use its
# MinIO service; for a host-run api/worker against that MinIO use
# OBJECT_STORAGE_URL=http://localhost:9000 and the MINIO_ROOT_* values.
STORAGE_BACKEND=local
# UPLOAD_STORAGE_DIR=/absolute/path/to/uploads
OBJECT_STORAGE_URL=
OBJECT_STORAGE_BUCKET=synthveda-uploads
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
