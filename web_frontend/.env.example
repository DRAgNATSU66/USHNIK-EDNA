# Synth Veda frontend environment variables.
# Copy this file to .env and fill in your values before running the dev server.

# Backend API URL (no trailing slash)
# For local dev: http://127.0.0.1:8000
# For production: https://your-cloud-run-url.run.app
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Must be a Web client with http://localhost:5173 added as an authorized JavaScript origin.
# Leave blank to see a "Configure OAuth" placeholder on the login page.
VITE_GOOGLE_CLIENT_ID=
